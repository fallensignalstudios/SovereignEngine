# cmake -DBINARY=<path> -DFORBIDDEN="re1;re2" [-DFORBIDDEN_LIBS="re1;re2"] -P CheckBinarySymbols.cmake
# Fails if the binary's demangled symbols (nm -C) or its dynamic dependencies (ldd) match any
# forbidden pattern. Used to prove module boundaries in built artifacts, not just in CMake.
find_program(NM nm REQUIRED)
execute_process(COMMAND "${NM}" -C "${BINARY}" OUTPUT_VARIABLE symbols RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nm failed on ${BINARY}")
endif()
string(LENGTH "${symbols}" n)
set(found "")
foreach(pattern IN LISTS FORBIDDEN)
  string(REGEX MATCH "[^\n]*${pattern}[^\n]*" hit "${symbols}")
  if(hit)
    list(APPEND found "symbol /${pattern}/: ${hit}")
  endif()
endforeach()
if(FORBIDDEN_LIBS)
  find_program(LDD ldd)
  if(LDD)
    execute_process(COMMAND "${LDD}" "${BINARY}" OUTPUT_VARIABLE libs ERROR_QUIET)
    foreach(pattern IN LISTS FORBIDDEN_LIBS)
      string(REGEX MATCH "[^\n]*${pattern}[^\n]*" hit "${libs}")
      if(hit)
        list(APPEND found "library /${pattern}/: ${hit}")
      endif()
    endforeach()
  endif()
endif()
if(found)
  list(JOIN found "\n  " text)
  message(FATAL_ERROR "${BINARY} contains forbidden references:\n  ${text}")
endif()
message(STATUS "${BINARY}: ${n} bytes of symbol table scanned; no forbidden references")
