# cmake -DSOURCE_DIR=<repo> -P CheckPacketCopies.cmake
# docs/packet/ is the owner's First Ignition packet, verbatim. Every file must match the packet's
# own MANIFEST.sha256.json, and the files the repository uses from it (AGENTS.md, the validation
# matrix, schemas, examples, the contract checker) must be byte-identical copies.
set(packet "${SOURCE_DIR}/docs/packet")
file(READ "${packet}/MANIFEST.sha256.json" manifest)
string(JSON n LENGTH "${manifest}")
math(EXPR last "${n} - 1")
set(problems "")
foreach(i RANGE ${last})
  string(JSON rel MEMBER "${manifest}" ${i})
  string(JSON want GET "${manifest}" "${rel}")
  if(NOT EXISTS "${packet}/${rel}")
    list(APPEND problems "docs/packet/${rel} missing")
    continue()
  endif()
  file(SHA256 "${packet}/${rel}" have)
  if(NOT have STREQUAL want)
    list(APPEND problems "docs/packet/${rel} sha256 ${have} != manifest ${want}")
  endif()
endforeach()
foreach(rel AGENTS.md docs/VALIDATION_MATRIX.md schemas/scene.schema.json schemas/command_batch.schema.json
            examples/first_light.scene.json examples/place_banner.command_batch.json
            tools/validate_contract_examples.py)
  string(JSON want GET "${manifest}" "${rel}")
  if(NOT EXISTS "${SOURCE_DIR}/${rel}")
    list(APPEND problems "${rel} missing (must be the packet copy)")
    continue()
  endif()
  file(SHA256 "${SOURCE_DIR}/${rel}" have)
  if(NOT have STREQUAL want)
    list(APPEND problems "${rel} differs from the packet (sha256 ${have}); contract files change only with an owner-approved decision")
  endif()
endforeach()
if(problems)
  list(JOIN problems "\n  " t)
  message(FATAL_ERROR "packet copy problems:\n  ${t}")
endif()
message(STATUS "${n} packet files match MANIFEST.sha256.json; 7 repository copies are verbatim")
