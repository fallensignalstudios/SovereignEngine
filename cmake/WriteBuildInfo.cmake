# Runs at build time (cmake -P) so the embedded commit reflects the tree being compiled,
# not the tree that was configured. Rewrites the header only when its content changes.
#
# Inputs: SOURCE_DIR, OUTPUT, VERSION, LOCK_SHA256, BUILD_TYPE, COMPILER, SYSTEM, GRAPHICS

execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
  set(commit "uncommitted")
endif()

execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
  OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  set(tree "unknown")
elseif(status STREQUAL "")
  set(tree "clean")
else()
  set(tree "modified")
endif()

set(content "// Generated by cmake/WriteBuildInfo.cmake. Do not edit.
#pragma once
#define SOV_VERSION \"${VERSION}\"
#define SOV_GIT_COMMIT \"${commit}\"
#define SOV_GIT_TREE_STATE \"${tree}\"
#define SOV_DEPENDENCY_LOCK_SHA256 \"${LOCK_SHA256}\"
#define SOV_BUILD_TYPE \"${BUILD_TYPE}\"
#define SOV_COMPILER \"${COMPILER}\"
#define SOV_TARGET_SYSTEM \"${SYSTEM}\"
#define SOV_GRAPHICS_BUILD ${GRAPHICS}
")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
else()
  set(existing "")
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
