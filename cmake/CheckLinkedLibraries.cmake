# cmake -DBINARY=<path> [-DSANITIZED=ON] -P CheckLinkedLibraries.cmake
# G0-06 link-level inspection: the executable's DT_NEEDED entries are only the C/C++ runtime, it
# carries no RPATH/RUNPATH into another tree, and its symbols name no Unreal Engine types.
# (Libraries loaded at run time, the Vulkan loader, the driver and X11 via dlopen, are checked
# by scripts/loaded_libraries_check.sh against a running process.)
find_program(READELF readelf REQUIRED)
find_program(NM nm REQUIRED)
execute_process(COMMAND "${READELF}" -d "${BINARY}" OUTPUT_VARIABLE dyn RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "readelf -d failed on ${BINARY}")
endif()
set(allowed "^(libstdc\\+\\+\\.so\\.6|libm\\.so\\.6|libgcc_s\\.so\\.1|libc\\.so\\.6|libdl\\.so\\.2|libpthread\\.so\\.0|ld-linux-x86-64\\.so\\.2)$")
if(SANITIZED)  # sanitizer builds (SOV_SANITIZE) also link the compiler's sanitizer runtimes
  set(allowed "^(libstdc\\+\\+\\.so\\.6|libm\\.so\\.6|libgcc_s\\.so\\.1|libc\\.so\\.6|libdl\\.so\\.2|libpthread\\.so\\.0|ld-linux-x86-64\\.so\\.2|libasan\\.so\\.[0-9]+|libubsan\\.so\\.[0-9]+|libtsan\\.so\\.[0-9]+)$")
endif()
set(problems "")
set(needed "")
string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[[^]]+\\]" lines "${dyn}")
foreach(l IN LISTS lines)
  string(REGEX REPLACE ".*\\[([^]]+)\\]" "\\1" lib "${l}")
  list(APPEND needed "${lib}")
  if(NOT lib MATCHES "${allowed}")
    list(APPEND problems "unexpected link-time dependency ${lib}")
  endif()
endforeach()
if(dyn MATCHES "\\((RPATH|RUNPATH)\\)[^\n]*")
  list(APPEND problems "embedded search path: ${CMAKE_MATCH_0}")
endif()
execute_process(COMMAND "${NM}" -C "${BINARY}" OUTPUT_VARIABLE symbols ERROR_QUIET)
foreach(p "UObject" "UClass" "FName::" "UE::" "FString" "UnrealEditor" "EpicGames" "IModuleInterface")
  string(REGEX MATCH "[^\n]*${p}[^\n]*" hit "${symbols}")
  if(hit)
    list(APPEND problems "symbol /${p}/: ${hit}")
  endif()
endforeach()
if(problems)
  list(JOIN problems "\n  " t)
  message(FATAL_ERROR "${BINARY}:\n  ${t}")
endif()
list(JOIN needed ", " n)
message(STATUS "${BINARY}: NEEDED = ${n}; no RPATH/RUNPATH; no Unreal symbols")
