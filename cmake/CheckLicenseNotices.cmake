# cmake -DSOURCE_DIR=<repo> [-DFETCHED="name=dir;..."] -P CheckLicenseNotices.cmake
# Every dependency's committed notice copy must match the licence hash recorded in the lock, and,
# for dependencies fetched in this build tree, the upstream licence file must match too.
macro(_sov_check_copy label path want)
  if(NOT EXISTS "${path}")
    list(APPEND problems "${label}: ${path} missing")
  else()
    file(SHA256 "${path}" _have)
    if(NOT _have STREQUAL "${want}")
      list(APPEND problems "${label}: ${path} sha256 ${_have} != lock ${want}")
    endif()
    math(EXPR checked "${checked} + 1")
  endif()
endmacro()

set(checked 0)
file(READ "${SOURCE_DIR}/dependencies.lock.json" lock)
string(JSON n LENGTH "${lock}" dependencies)
math(EXPR last "${n} - 1")
set(problems "")
foreach(i RANGE ${last})
  string(JSON name GET "${lock}" dependencies ${i} name)
  string(JSON copy GET "${lock}" dependencies ${i} license notice_copy)
  string(JSON want GET "${lock}" dependencies ${i} license sha256)
  string(JSON lic_file GET "${lock}" dependencies ${i} license file)
  if(NOT EXISTS "${SOURCE_DIR}/${copy}")
    list(APPEND problems "${name}: notice copy ${copy} missing")
    continue()
  endif()
  file(SHA256 "${SOURCE_DIR}/${copy}" have)
  if(NOT have STREQUAL want)
    list(APPEND problems "${name}: ${copy} sha256 ${have} != lock ${want}")
  endif()
  foreach(entry IN LISTS FETCHED)
    string(REPLACE "=" ";" kv "${entry}")
    list(GET kv 0 fname)
    list(GET kv 1 fdir)
    if(fname STREQUAL name AND EXISTS "${fdir}/${lic_file}")
      file(SHA256 "${fdir}/${lic_file}" upstream)
      if(NOT upstream STREQUAL want)
        list(APPEND problems "${name}: fetched ${lic_file} sha256 ${upstream} != lock ${want}")
      endif()
      message(STATUS "${name}: fetched licence matches lock")
    endif()
  endforeach()
  # Optional extra notices: additional upstream files, and a source build's own notices and submodules
  # (dxc, ADR-015). Copies must match the lock; the upstream file is compared when it is present.
  string(JSON extra ERROR_VARIABLE no_extra GET "${lock}" dependencies ${i} license additional_sha256)
  if(NOT no_extra)
    string(JSON ne LENGTH "${extra}")
    math(EXPR ne_last "${ne} - 1")
    foreach(k RANGE ${ne_last})
      string(JSON f MEMBER "${extra}" ${k})
      string(JSON w GET "${extra}" "${f}")
      _sov_check_copy("${name}" "${SOURCE_DIR}/third_party_notices/${name}/${f}" "${w}")
    endforeach()
  endif()
  string(JSON copies ERROR_VARIABLE no_copies GET "${lock}" dependencies ${i} source_build license notice_copies)
  if(NOT no_copies)
    string(JSON nc LENGTH "${copies}")
    math(EXPR nc_last "${nc} - 1")
    foreach(k RANGE ${nc_last})
      string(JSON f MEMBER "${copies}" ${k})
      string(JSON c GET "${copies}" "${f}" copy)
      string(JSON w GET "${copies}" "${f}" sha256)
      _sov_check_copy("${name}" "${SOURCE_DIR}/${c}" "${w}")
      file(GLOB built_src "${SOURCE_DIR}/build/tools/${name}-*/src/${f}")
      foreach(u IN LISTS built_src)
        _sov_check_copy("${name} (source build)" "${u}" "${w}")
      endforeach()
    endforeach()
  endif()
  string(JSON subs ERROR_VARIABLE no_subs GET "${lock}" dependencies ${i} source_build submodules)
  if(NOT no_subs)
    string(JSON ns LENGTH "${subs}")
    math(EXPR ns_last "${ns} - 1")
    foreach(k RANGE ${ns_last})
      string(JSON c GET "${subs}" ${k} notice_copy)
      string(JSON w GET "${subs}" ${k} sha256)
      string(JSON sp GET "${subs}" ${k} path)
      _sov_check_copy("${name} ${sp}" "${SOURCE_DIR}/${c}" "${w}")
      file(GLOB built_src "${SOURCE_DIR}/build/tools/${name}-*/src/${sp}/LICENSE")
      foreach(u IN LISTS built_src)
        _sov_check_copy("${name} ${sp} (source build)" "${u}" "${w}")
      endforeach()
    endforeach()
  endif()
endforeach()
if(problems)
  list(JOIN problems "\n  " t)
  message(FATAL_ERROR "licence notice problems:\n  ${t}")
endif()
message(STATUS "${n} dependency notices and ${checked} additional notice files match dependencies.lock.json")
