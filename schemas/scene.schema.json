{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereign-engine:schema:scene:1",
  "title": "Sovereign Engine G1 scene contract v1",
  "description": "Proposed authoring contract. Additional semantic validation is required; this is not an engine implementation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scene_id": {
      "$ref": "#/$defs/UUID"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "active_camera_id": {
      "$ref": "#/$defs/UUID"
    },
    "background_linear_rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/Entity"
      }
    }
  },
  "required": [
    "schema_version",
    "scene_id",
    "name",
    "revision",
    "active_camera_id",
    "background_linear_rgb",
    "entities"
  ],
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "rotation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.0001,
            "maximum": 10000
          }
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "position",
        "rotation_xyzw",
        "scale",
        "parent_id"
      ]
    },
    "MaterialParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_color_rgba": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "emissive_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        }
      },
      "required": [
        "base_color_rgba",
        "emissive_rgb"
      ]
    },
    "PrimitiveMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primitive": {
          "enum": [
            "box",
            "plane",
            "cylinder"
          ]
        }
      },
      "required": [
        "primitive"
      ]
    },
    "Camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projection": {
          "const": "perspective"
        },
        "fov_y_degrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 179
        },
        "near_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "far_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "projection",
        "fov_y_degrees",
        "near_m",
        "far_m"
      ]
    },
    "Components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Transform": {
          "$ref": "#/$defs/Transform"
        },
        "PrimitiveMesh": {
          "$ref": "#/$defs/PrimitiveMesh"
        },
        "MaterialParameters": {
          "$ref": "#/$defs/MaterialParameters"
        },
        "Camera": {
          "$ref": "#/$defs/Camera"
        }
      },
      "required": [
        "Transform"
      ],
      "dependentRequired": {
        "PrimitiveMesh": [
          "MaterialParameters"
        ],
        "MaterialParameters": [
          "PrimitiveMesh"
        ]
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "components": {
          "$ref": "#/$defs/Components"
        }
      },
      "required": [
        "id",
        "name",
        "components"
      ]
    }
  }
}
