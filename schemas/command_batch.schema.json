{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereign-engine:schema:command-batch:1",
  "title": "Sovereign Engine G1 command batch contract v1",
  "description": "Local typed authoring request. actor is a label, not authentication. The engine must implement transactional semantics separately.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/UUID"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scene_id": {
      "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/UUID"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "dry_run": {
      "type": "boolean"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "entity.create"
              },
              "entity": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/Entity"
              }
            },
            "required": [
              "op",
              "entity"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "entity.rename"
              },
              "entity_id": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/UUID"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "op",
              "entity_id",
              "name"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "transform.set"
              },
              "entity_id": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/UUID"
              },
              "transform": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/Transform"
              }
            },
            "required": [
              "op",
              "entity_id",
              "transform"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "material.set"
              },
              "entity_id": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/UUID"
              },
              "material": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/MaterialParameters"
              }
            },
            "required": [
              "op",
              "entity_id",
              "material"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "entity.delete"
              },
              "entity_id": {
                "$ref": "urn:sovereign-engine:schema:scene:1#/$defs/UUID"
              }
            },
            "required": [
              "op",
              "entity_id"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "actor",
    "scene_id",
    "base_revision",
    "idempotency_key",
    "dry_run",
    "operations"
  ]
}
