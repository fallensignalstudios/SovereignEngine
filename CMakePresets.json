{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
        "SOV_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-headless",
      "inherits": "base",
      "displayName": "Headless development (core, scene, commands, CLI; no SDL or Vulkan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOV_ENABLE_GRAPHICS": "OFF"
      }
    },
    {
      "name": "dev-headless-asan",
      "inherits": "dev-headless",
      "displayName": "Headless development with AddressSanitizer + UndefinedBehaviorSanitizer (GCC/Clang)",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "SOV_SANITIZE": "address;undefined"
      }
    },
    {
      "name": "dev-vulkan",
      "inherits": "base",
      "displayName": "Graphics development (SDL3 window + native Vulkan 1.3 renderer, editor, runtime)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOV_ENABLE_GRAPHICS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-headless", "configurePreset": "dev-headless" },
    { "name": "dev-headless-asan", "configurePreset": "dev-headless-asan" },
    { "name": "dev-vulkan", "configurePreset": "dev-vulkan" }
  ],
  "testPresets": [
    {
      "name": "dev-headless",
      "configurePreset": "dev-headless",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "headless" } },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    {
      "name": "dev-headless-asan",
      "configurePreset": "dev-headless-asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "headless" } },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    {
      "name": "dev-vulkan",
      "configurePreset": "dev-vulkan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 1 }
    },
    {
      "name": "gpu-qualify",
      "displayName": "Physical-GPU qualification: Vulkan tests fail if the selected device is a CPU/software implementation",
      "configurePreset": "dev-vulkan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "vulkan" } },
      "environment": { "SOV_REQUIRE_PHYSICAL_GPU": "1" },
      "execution": { "noTestsAction": "error", "jobs": 1 }
    }
  ]
}
