{
  "steps": [
    {"do": "wait_frames", "n": 10},
    {"do": "capture_window", "path": "editor_01_opened.png"},
    {"do": "pick", "name": "Altar"},
    {"do": "expect", "selected": "Altar", "revision": 1, "dirty": false},
    {"do": "select", "name": "Column W3"},
    {"do": "move", "name": "Column W3", "delta": [1.5, 0.0, 0.0]},
    {"do": "expect", "revision": 2, "dirty": true},
    {"do": "capture_window", "path": "editor_02_column_moved.png"},
    {"do": "undo"},
    {"do": "expect", "revision": 3},
    {"do": "capture_viewport", "path": "editor_03_move_undone_viewport.png"},
    {"do": "set_material", "name": "Altar", "field": "base_color", "value": [0.72, 0.40, 0.12]},
    {"do": "set_material", "name": "Altar", "field": "roughness", "value": 0.18},
    {"do": "expect", "revision": 5},
    {"do": "select", "name": "Altar"},
    {"do": "save"},
    {"do": "expect", "dirty": false, "document_hash_equals_saved": true},
    {"do": "capture_window", "path": "editor_04_material_saved.png"},
    {"do": "play"},
    {"do": "play_ticks", "n": 120},
    {"do": "capture_window", "path": "editor_05_playing.png"},
    {"do": "stop"},
    {"do": "expect", "playing": false, "revision": 5, "dirty": false, "document_hash_equals_saved": true},
    {"do": "reopen"},
    {"do": "expect", "revision": 5, "dirty": false, "document_hash_equals_saved": true},
    {"do": "cycles", "n": 10},
    {"do": "resize_window", "w": 1280, "h": 720},
    {"do": "minimize"},
    {"do": "restore"},
    {"do": "resize_window", "w": 1600, "h": 900},
    {"do": "select", "name": "Column E2 Shaft"},
    {"do": "capture_window", "path": "editor_06_after_lifecycle.png"},
    {"do": "report", "path": "editor_report.json"},
    {"do": "quit"}
  ]
}
