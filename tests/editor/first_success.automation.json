{
  "steps": [
    {"do": "wait_frames", "n": 10},
    {"do": "capture_window", "path": "editor_01_opened.png"},
    {"do": "pick", "name": "Raised platform"},
    {"do": "expect", "selected": "Raised platform", "revision": 0, "dirty": false},
    {"do": "select", "name": "Column 2"},
    {"do": "move", "name": "Column 2", "delta": [1.5, 0.0, 0.0]},
    {"do": "expect", "revision": 1, "dirty": true},
    {"do": "capture_window", "path": "editor_02_column_moved.png"},
    {"do": "undo"},
    {"do": "expect", "revision": 2},
    {"do": "capture_viewport", "path": "editor_03_move_undone_viewport.png"},
    {"do": "set_material", "name": "Raised platform", "field": "base_color_rgba", "value": [0.72, 0.40, 0.12, 1.0]},
    {"do": "set_material", "name": "Platform light strip", "field": "emissive_rgb", "value": [2.8, 0.9, 0.12]},
    {"do": "expect", "revision": 4},
    {"do": "select", "name": "Raised platform"},
    {"do": "save"},
    {"do": "expect", "dirty": false, "document_hash_equals_saved": true},
    {"do": "capture_window", "path": "editor_04_material_saved.png"},
    {"do": "play"},
    {"do": "play_ticks", "n": 120},
    {"do": "capture_window", "path": "editor_05_playing.png"},
    {"do": "stop"},
    {"do": "expect", "playing": false, "revision": 4, "dirty": false, "document_hash_equals_saved": true},
    {"do": "reopen"},
    {"do": "expect", "revision": 4, "dirty": false, "document_hash_equals_saved": true},
    {"do": "cycles", "n": 50},
    {"do": "resize_window", "w": 1280, "h": 720},
    {"do": "minimize"},
    {"do": "restore"},
    {"do": "resize_window", "w": 1600, "h": 900},
    {"do": "select", "name": "Column 5"},
    {"do": "capture_window", "path": "editor_06_after_lifecycle.png"},
    {"do": "report", "path": "editor_report.json"},
    {"do": "quit"}
  ]
}
